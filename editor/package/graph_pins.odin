package unreal

// A pin of a node of an editor graph (UEdGraphPin), as UEdGraphNode keeps its
// pins after its tagged properties: what reading it needs of a graph that is
// not compiled, such as the value a static switch of a Niagara module takes.
Graph_Pin :: struct {
    name:Name_Ref,
    input:bool,
    category:Name_Ref,
    sub_object:Object_Ref,  // an enum, a struct or a class of the type
    default_value:string,
    links:int,              // pins it is connected to
    bits:u32,               // GRAPH_PIN_*
    persistent:bool,        // it keeps a PersistentGuid
}

GRAPH_PIN_NOT_CONNECTABLE :: u32(0x2)
GRAPH_PIN_DEFAULT_IGNORED :: u32(0x8)
GRAPH_PIN_ORPHANED        :: u32(0x20)

@(private="file") UE5_RELEASE_STREAM_VERSION :: [4]u32{0xd89b5e42,0x24bd4d46,0x8412aca8,0xdf641779}
@(private="file") UE5_MAIN_PIN_SOURCE_INDEX :: 50
@(private="file") UE5_RELEASE_PIN_SINGLE_PRECISION :: 36

// The pins of a graph node, an export of the package, in their order.
graph_node_pins :: proc(p:^Package,export:int,allocator:=context.allocator) -> (pins:[]Graph_Pin,error:Error) {
    list,list_error:=export_properties(p,export,true,context.temp_allocator)
    if list_error.code!=.None {return nil,list_error}
    payload,payload_error:=object_native_payload(p,list.trailing)
    if payload_error.code!=.None {return nil,payload_error}
    main,_:=custom_version(p,UE5_MAIN_STREAM_VERSION)
    release,_:=custom_version(p,UE5_RELEASE_STREAM_VERSION)
    r:=Reader{bytes=p.bytes,at=int(payload.offset),end=int(payload.offset+payload.size)}
    count:=i32_read(&r,"pin count")
    if r.error.code!=.None {return nil,r.error}
    if count<0 || u32(count)>p.limits.table_entries {return nil,{.Limit,payload.offset,"pin count"}}
    out:=make([dynamic]Graph_Pin,0,int(count),allocator)
    for _ in 0..<count {
        if bool_read(&r,"pin is null") {continue}
        _=take(&r,20,"pin owner")
        _=take(&r,20,"pin id")
        pin:Graph_Pin
        pin.name=name_read(&r,p,"pin name")
        graph_text_skip(&r,p,"pin friendly name")
        if main>=UE5_MAIN_PIN_SOURCE_INDEX {_=i32_read(&r,"pin source index")}
        _=text_read(&r,p.limits.text_bytes,"pin tooltip")
        pin.input=u8_read(&r,"pin direction")==0
        pin.category=name_read(&r,p,"pin category")
        _=name_read(&r,p,"pin subcategory")
        pin.sub_object=reference_read(&r,p,"pin subcategory object")
        if u8_read(&r,"pin container")==3 {
            _=name_read(&r,p,"pin map value category")
            _=name_read(&r,p,"pin map value subcategory")
            _=take(&r,16,"pin map value type")
        }
        _=take(&r,8,"pin reference flags")
        _=take(&r,4,"pin member parent")
        _=name_read(&r,p,"pin member name")
        _=take(&r,24,"pin member guid and flags")
        if release>=UE5_RELEASE_PIN_SINGLE_PRECISION {_=u32_read(&r,"pin single precision")}
        value:=text_read(&r,p.limits.text_bytes,"pin default value")
        _=text_read(&r,p.limits.text_bytes,"pin autogenerated default value")
        _=i32_read(&r,"pin default object")
        graph_text_skip(&r,p,"pin default text")
        pin.links=graph_pin_refs_skip(&r,"pin links")
        graph_pin_refs_skip(&r,"pin subpins")
        for _ in 0..<2 {if !bool_read(&r,"pin parent is null") {_=take(&r,20,"pin parent")}}
        persistent:=guid_read(&r,"pin persistent guid")
        pin.persistent=persistent!={}
        pin.bits=u32_read(&r,"pin bits")
        if r.error.code!=.None {delete(out);return nil,r.error}
        text,_,text_error:=text_decode(value,allocator)
        if text_error.code!=.None {delete(out);return nil,text_error}
        pin.default_value=text
        append(&out,pin)
    }
    if r.at!=r.end {delete(out);return nil,{.Malformed,i64(r.at),"graph node pins have trailing bytes"}}
    return out[:],{}
}

@(private="file")
graph_pin_refs_skip :: proc(r:^Reader,field:string) -> int {
    count:=i32_read(r,field)
    if count<0 {bad(r,.Malformed,field);return 0}
    for _ in 0..<count {if !bool_read(r,field) {_=take(r,20,field)}}
    return int(count)
}

// An FText: the source string of the histories graphs keep, "" for others.
@(private="file")
graph_text_read :: proc(r:^Reader,p:^Package,field:string) -> (text:Serialized_String) {
    _=u32_read(r,field)
    switch history:=i8(u8_read(r,field));history {
    case -1:
        if bool_read(r,field) {text=text_read(r,p.limits.text_bytes,field)}
    case 0:
        _=text_read(r,p.limits.text_bytes,field)
        _=text_read(r,p.limits.text_bytes,field)
        text=text_read(r,p.limits.text_bytes,field)
    case 11:
        _=name_read(r,p,field)
        text=text_read(r,p.limits.text_bytes,field)
    case:
        bad(r,.Unsupported_Value,field)
    }
    return
}

@(private="file")
graph_text_skip :: proc(r:^Reader,p:^Package,field:string) {_=graph_text_read(r,p,field)}

// An entry of an enum an asset defines (UUserDefinedEnum): its name without
// the enum, its value and the name the editor shows of it.
User_Enum_Entry :: struct {name:string,value:i64,display:string}

user_enum_entries :: proc(p:^Package,export:int,allocator:=context.allocator) -> (entries:[]User_Enum_Entry,error:Error) {
    list,list_error:=export_properties(p,export,true,context.temp_allocator)
    if list_error.code!=.None {return nil,list_error}
    payload,payload_error:=object_native_payload(p,list.trailing)
    if payload_error.code!=.None {return nil,payload_error}
    r:=Reader{bytes=p.bytes,at=int(payload.offset),end=int(payload.offset+payload.size)}
    count:=i32_read(&r,"enum entry count")
    if r.error.code!=.None {return nil,r.error}
    if count<0 || u32(count)>p.limits.table_entries {return nil,{.Limit,payload.offset,"enum entry count"}}
    out:=make([]User_Enum_Entry,int(count),allocator)
    for &entry in out {
        name:=name_plain(p,name_read(&r,p,"enum entry name"))
        if at:=index_of(name,"::");at>=0 {name=name[at+2:]}
        entry.name,entry.value=name,i64_read(&r,"enum entry value")
    }
    if r.error.code!=.None {delete(out,allocator);return nil,r.error}
    names:=property_find(p,&list,"DisplayNameMap")
    if names==nil {return out,{}}
    m:=Reader{bytes=p.bytes,at=int(names.data.offset),end=int(names.data.offset+names.data.size)}
    _=i32_read(&m,"display names removed")
    shown:=i32_read(&m,"display name count")
    for _ in 0..<max(shown,0) {
        key:=name_plain(p,name_read(&m,p,"display name key"))
        text:=graph_text_read(&m,p,"display name")
        if m.error.code!=.None {break}
        display,_,display_error:=text_decode(text,allocator)
        if display_error.code!=.None {continue}
        for &entry in out {if entry.name==key {entry.display=display}}
    }
    return out,{}
}

@(private="file")
index_of :: proc(s,sub:string) -> int {
    for i in 0..=len(s)-len(sub) {if s[i:i+len(sub)]==sub {return i}}
    return -1
}
